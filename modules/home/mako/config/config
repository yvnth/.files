font=JetBrainsMono Nerd Font Propo 11
width=360
height=320
margin=20,20,60,20
padding=14
border-size=2
border-radius=0
max-visible=20
sort=-time
layer=overlay
anchor=top-right
markup=true
format=<b>%s</b>\n%b
text-alignment=left
icons=true
icon-location=left
max-icon-size=96
progress-color=#f4b8e4
background-color=#303446
text-color=#c6d0f5
border-color=#f4b8e4
default-timeout=8000
ignore-timeout=false
group-by=app-name
actions=true

[urgency=low]
background-color=#303446
text-color=#c6d0f5
border-color=#737994
default-timeout=5000

[urgency=normal]
background-color=#303446
text-color=#c6d0f5
border-color=#f4b8e4
default-timeout=8000

[urgency=critical]
background-color=#303446
text-color=#e78284
border-color=#e78284
default-timeout=0
